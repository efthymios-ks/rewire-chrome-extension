{
  "manifest_version": 3,
  "name": "Rewire",
  "version": "0.0.4",
  "description": "Inspect HTTP traffic in a side panel and rewire it with ordered rules: mock, redirect, rewrite, set headers. HAR, cURL, JWT.",
  "minimum_chrome_version": "126",
  "permissions": [
    "sidePanel",
    "debugger",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "storage",
    "cookies",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "action": {
    "default_title": "Open Rewire",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
